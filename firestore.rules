rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. ÉCOLES et GROUPES : Doivent être lisibles par tous pour que
    // l'application puisse valider les codes d'accès AVANT la création du compte.
    match /codes_ecole/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /groupes/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. PROFILS : Il faut être connecté pour les lire/écrire
    match /profs/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /eleves/{document=**} {
      allow read, write: if request.auth != null;
    }

    // 3. RÉSULTATS : Il faut être connecté
    match /resultats_eleves/{document=**} {
      allow read, write: if request.auth != null;
    }

    // 4. SYSTÈME (La bannière d'alerte)
    match /systeme/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "christopher.plante@gmail.com";
    }

    // ------------------------------------------------------------------
    // 5. FRANÇAIS 5 — préparation à l'épreuve unique de français, 5e sec.
    // Section ajoutée pour cette application ; ne touche à rien ci-dessus.
    // L'élève arrive via le tableau de bord (nom + code), sans mot de passe
    // : le client se connecte de façon anonyme (Firebase Auth) pour obtenir
    // un identifiant propre à sa session, utilisé comme clé des documents.
    // ------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Profil + état de progression (examState, horodatages). Les
    // transitions officielles (dossier généré, notes validées, épreuve
    // démarrée/soumise, corrigée) sont écrites par les Cloud Functions
    // (Admin SDK), qui contournent ces règles. Le client ne peut modifier
    // que son propre nom affiché.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.examState == 'not_started';
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName']);
    }

    // Dossier préparatoire (corpus de textes). Généré une seule fois par une
    // Cloud Function et figé : le client ne peut que le lire.
    match /corpora/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Feuille de notes : l'élève y travaille à son rythme, sauvegarde en
    // temps réel autorisée pour le propriétaire.
    match /notes/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Verdict de conformité de la feuille de notes, émis par l'IA.
    match /validations/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Lettre ouverte soumise. Écrite par la fonction submitLetter (Admin SDK)
    // pour garantir l'horodatage serveur et le respect du délai de 3h15.
    match /submissions/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Correction automatisée selon la grille ministérielle à 5 critères.
    match /corrections/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Clé de correction cachée du dossier (thèse réelle, point de vue,
    // classification des arguments) : jamais lisible par le client, sert
    // uniquement aux Cloud Functions à évaluer les réponses de l'élève.
    match /corpusKeys/{uid} {
      allow read, write: if false;
    }

    // Section A — rétroaction formative sur l'analyse critique du dossier.
    match /readingAnalyses/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Banque d'arguments personnelle de l'élève, pour préparer sa thèse.
    match /argumentBank/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Section B — transcript de la discussion préparatoire avec l'IA.
    // Écrit uniquement par les Cloud Functions pour garantir la cohérence
    // du fil et empêcher l'élève de falsifier les réponses de son « pair ».
    match /discussions/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
